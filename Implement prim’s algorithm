
import networkx as nx

G = nx.Graph()

G.add_weighted_edges_from([
    ('A', 'B', 2),
    ('A', 'C', 3),
    ('B', 'C', 1),
    ('B', 'D', 4),
    ('C', 'D', 5)
])

mst = nx.minimum_spanning_tree(G, algorithm="prim")

print("Minimum Spanning Tree:")
for u, v, w in mst.edges(data="weight"):
    print(u, "-", v, ":", w)

print("Total Cost:", mst.size(weight="weight"))
